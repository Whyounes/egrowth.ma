---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Check from '../components/Check.astro';
import RequestForm from '../components/RequestForm.astro';

import { t } from '../i18n';
import { site } from '../data/site';
import { platforms } from '../data/platforms';
import { pathFor, isBuilt, type Locale, type RouteKey } from '../data/routes';
import { faqSchema, breadcrumbSchema, serviceSchema } from '../lib/schema';
import { richText } from '../lib/text';

export interface Props {
  lang: Locale;
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
const c = t(lang);
const a = c.adAccounts;

const trail = [{ label: c.nav.adAccounts, key: routeKey }];

const schema = [
  breadcrumbSchema(
    [{ label: c.nav.home, key: 'home' as RouteKey }, ...trail],
    lang,
    site.url,
  ),
  faqSchema(a.faq),
  serviceSchema({
    name: a.heroTitle,
    description: a.metaDescription,
    lang,
    siteUrl: site.url,
  }),
];

const setupLabel = { under24h: c.common.under24h, h24to48: c.common.h24to48 };
---

<Base lang={lang} routeKey={routeKey} title={a.metaTitle} description={a.metaDescription} schema={schema}>
  <Header lang={lang} routeKey={routeKey} />
  <Breadcrumb lang={lang} trail={trail} />

  <main id="main">
    <!-- ================= HERO + FORM ================= -->
    <section class="hero">
      <div class="container hero__grid">
        <div>
          <h1>{a.heroTitle}</h1>
          <p class="lead hero__lead">{a.heroLead}</p>
          <ul class="checks hero__checks">
            {a.heroChecks.map((item) => <Check>{item}</Check>)}
          </ul>
          <dl class="hero__stats">
            <div>
              <dt class="num">{site.stats.accountsProvisioned}</dt>
              <dd>{a.statAccounts}</dd>
            </div>
            <div>
              <dt class="num">{site.stats.activationMedian}</dt>
              <dd>{a.statActivation}</dd>
            </div>
            <div>
              <dt class="num">{site.stats.stillActiveAt12Months}%</dt>
              <dd>{a.statRetention}</dd>
            </div>
          </dl>
        </div>
        <RequestForm lang={lang} />
      </div>
    </section>

    <!-- ================= WHAT YOU OWN ================= -->
    <section class="section">
      <div class="container own">
        <div class="intro">
          <p class="eyebrow">{a.ownEyebrow}</p>
          <h2>{a.ownTitle}</h2>
          <p class="lead">{a.ownLead}</p>
        </div>

        <div class="own__table">
          <div class="own__col own__col--yours">
            <p class="eyebrow own__tag">{a.ownYoursTag}</p>
            <h3 class="own__colTitle">{a.ownYoursTitle}</h3>
            <dl>
              {a.ownYours.map((item) => (<div><dt>{item.t}</dt><dd>{item.d}</dd></div>))}
            </dl>
          </div>
          <div class="own__col own__col--ours">
            <p class="eyebrow eyebrow--muted own__tag">{a.ownOursTag}</p>
            <h3 class="own__colTitle">{a.ownOursTitle}</h3>
            <dl>
              {a.ownOurs.map((item) => (<div><dt>{item.t}</dt><dd>{item.d}</dd></div>))}
            </dl>
          </div>
        </div>

        <div class="caution own__caution">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="8.2" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M10 6v5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            <circle cx="10" cy="13.8" r="0.9" fill="currentColor"></circle>
          </svg>
          <p set:html={richText(a.caution)} />
        </div>
      </div>
    </section>

    <!-- ================= PLATFORMS ================= -->
    <section class="section section--band">
      <div class="container">
        <div class="intro">
          <h2>{a.platformsTitle}</h2>
          <p class="lead">{a.platformsLead}</p>
        </div>

        <div class="grid grid--3">
          {
            platforms.map((p) => {
              const meta = site.platforms[p.key];
              const built = isBuilt(p.routeKey);
              return (
                <article class="plat card">
                  <div class="plat__head">
                    <div class="plat__brand">
                      {p.icons.map((icon) => <PlatformIcon name={icon} size={26} />)}
                      <h3>{p.label}</h3>
                    </div>
                    {p.mostRequested && <span class="plat__tag">{c.common.mostRequested}</span>}
                  </div>
                  <p class="plat__tagline">{c.platformPages[p.key].tagline}</p>
                  <dl class="plat__meta">
                    <div>
                      <dt>{c.common.setup}</dt>
                      <dd>{setupLabel[meta.setup as 'under24h' | 'h24to48']}</dd>
                    </div>
                    <div>
                      <dt>{c.common.fee}</dt>
                      <dd class="num">MAD {meta.fee}{c.common.perMonth}</dd>
                    </div>
                    <div>
                      <dt>{c.common.minBudget}</dt>
                      <dd class="num">{meta.minBudget} MAD{c.common.perMonth}</dd>
                    </div>
                  </dl>
                  {built && (
                    <a class="arrowLink plat__link" href={pathFor(p.routeKey, lang)}>
                      {p.label}
                    </a>
                  )}
                </article>
              );
            })
          }

          <article class="plat plat--ask">
            <h3>{a.platformsUnsureTitle}</h3>
            <p>{a.platformsUnsureBody}</p>
            <a class="btn btn--onDark plat__askCta" href="#request">{a.platformsUnsureCta}</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= WHO WE TURN DOWN ================= -->
    <section class="section">
      <div class="container no">
        <div>
          <h2>{a.noTitle}</h2>
          <p class="lead no__lead">{a.noLead}</p>
        </div>
        <ul class="no__list">
          {
            a.noItems.map((item) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M5.5 5.5l9 9M14.5 5.5l-9 9"
                    stroke="#a3341f"
                    stroke-width="2.1"
                    stroke-linecap="round"></path>
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Faq title={a.faqTitle} items={a.faq} />
    <CtaBand lang={lang} title={a.ctaTitle} lead={a.ctaLead} dark />
  </main>

  <Footer lang={lang} routeKey={routeKey} />
</Base>

<style>
  .hero {
    padding-block: var(--section-y);
    background: linear-gradient(180deg, var(--c-bg) 0%, var(--c-bg-2) 100%);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(26.25rem, 100%), 1fr));
    gap: var(--s-16) var(--s-12);
    align-items: start;
  }

  .hero__lead {
    margin-block: var(--s-5, 1.25rem) var(--s-8);
  }

  .hero__checks {
    margin-block-end: var(--s-8);
  }

  .hero__checks :global(li) {
    font-size: 0.96875rem;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6) var(--s-12);
    padding-block: var(--s-6);
    border-block: 1px solid var(--c-line);
  }

  .hero__stats dt {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .hero__stats dd {
    margin: 0;
    font-size: var(--t-xs);
    color: var(--c-ink-3);
  }

  .intro {
    max-width: 41.25rem;
    margin-block-end: var(--s-12);
  }

  .intro .eyebrow { margin-block-end: var(--s-3); }
  .intro h2 + .lead { margin-block-start: var(--s-4); }

  /* --- What you own ----------------------------------------------------- */
  .own {
    max-width: 62.5rem;
  }

  .own__table {
    border: 1px solid var(--c-line);
    border-radius: 18px;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18.75rem, 100%), 1fr));
  }

  .own__col {
    padding: var(--s-8);
  }

  .own__col--yours {
    background: var(--c-green-tint);
  }

  .own__col--ours {
    background: var(--c-bg-2);
    border-inline-start: 1px solid var(--c-line);
  }

  .own__tag {
    margin-block-end: var(--s-2);
  }

  .own__colTitle {
    font-size: 1.25rem;
    margin-block-end: var(--s-6);
  }

  .own__col dl {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .own__col dt {
    font-size: 0.96875rem;
    font-weight: 700;
    margin-block-end: 3px;
  }

  .own__col dd {
    margin: 0;
    font-size: var(--t-small);
    line-height: 1.55;
    color: var(--c-ink-2);
  }

  .own__col--yours dd {
    color: #3f5a4f;
  }

  .own__caution {
    margin-block-start: var(--s-4);
  }

  /* --- Platform cards --------------------------------------------------- */
  .plat {
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .plat__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .plat__brand {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .plat__tag {
    padding: 4px 9px;
    font-size: 0.71875rem;
    font-weight: 700;
    color: var(--c-green);
    background: var(--c-green-tint);
    border-radius: 6px;
    white-space: nowrap;
  }

  .plat__tagline {
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--c-ink-2);
  }

  .plat__meta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-block-start: var(--s-3);
    border-block-start: 1px solid var(--c-line);
  }

  .plat__meta > div {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    font-size: var(--t-xs);
  }

  .plat__meta dt { color: var(--c-ink-3); }
  .plat__meta dd { margin: 0; font-weight: 700; }

  .plat__link {
    margin-block-start: auto;
    padding-block-start: var(--s-2);
  }

  .plat--ask {
    background: var(--c-dark);
    border: 0;
    border-radius: var(--r-card);
    color: #fff;
  }

  .plat--ask h3 { color: #fff; }

  .plat--ask p {
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--c-dark-ink-2);
  }

  .plat__askCta {
    margin-block-start: auto;
    width: 100%;
  }

  /* --- Who we turn down ------------------------------------------------- */
  .no {
    max-width: 62.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(25rem, 100%), 1fr));
    gap: var(--s-12);
  }

  .no__lead {
    margin-block-start: var(--s-4);
  }

  .no__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .no__list li {
    display: flex;
    gap: var(--s-3);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #3c434a;
  }

  .no__list svg {
    flex-shrink: 0;
    margin-block-start: 3px;
  }
</style>

---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Check from '../components/Check.astro';

import { t } from '../i18n';
import { site } from '../data/site';
import { platforms } from '../data/platforms';
import { pathFor, isBuilt, type Locale, type RouteKey } from '../data/routes';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
import { richText } from '../lib/text';

export interface Props {
  lang: Locale;
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
const c = t(lang);
const p = c.pricing;

const trail = [{ label: c.nav.pricing, key: routeKey }];
const schema = [
  breadcrumbSchema([{ label: c.nav.home, key: 'home' as RouteKey }, ...trail], lang, site.url),
  faqSchema(p.faq),
];

const setupLabel = { under24h: c.common.under24h, h24to48: c.common.h24to48 };

const tiers = [
  {
    name: p.tierAccount,
    note: p.tierAccountNote,
    price: `MAD ${site.pricing.accountOnly}`,
    unit: c.common.perMonth,
    includes: p.tierAccountIncludes,
    featured: false,
  },
  {
    name: p.tierManaged,
    note: p.tierManagedNote,
    price: `MAD ${site.pricing.accountPlusManagement}`,
    unit: c.common.perMonth,
    includes: p.tierManagedIncludes,
    featured: true,
  },
  {
    name: p.tierGrowth,
    note: p.tierGrowthNote,
    price: `MAD ${site.pricing.growthRetainerFrom}`,
    unit: c.common.perMonth,
    includes: p.tierGrowthIncludes,
    featured: false,
  },
];

const builds = [
  { name: c.home.buildStore, price: site.pricing.storeFrom, span: '4–6' },
  { name: c.home.buildApp, price: site.pricing.appFrom, span: '8–12' },
  { name: c.home.buildSite, price: site.pricing.websiteFrom, span: '2–4' },
  { name: c.home.buildTools, price: site.pricing.toolsFrom, span: '1–3' },
];
---

<Base lang={lang} routeKey={routeKey} title={p.metaTitle} description={p.metaDescription} schema={schema}>
  <Header lang={lang} routeKey={routeKey} />
  <Breadcrumb lang={lang} trail={trail} />

  <main id="main">
    <section class="hero">
      <div class="container hero__inner">
        <h1>{p.title}</h1>
        <p class="lead hero__lead">{p.lead}</p>
        <div class="caution hero__caution">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="8.2" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M10 6v5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            <circle cx="10" cy="13.8" r="0.9" fill="currentColor"></circle>
          </svg>
          <p set:html={richText(p.mediaNote)} />
        </div>
      </div>
    </section>

    <!-- Retainers -->
    <section class="section">
      <div class="container">
        <h2 class="secT">{p.retainersTitle}</h2>
        <div class="grid grid--3 tiers">
          {
            tiers.map((tier) => (
              <article class:list={['card', 'tier', { 'tier--on': tier.featured }]}>
                <h3>{tier.name}</h3>
                <p class="tier__note">{tier.note}</p>
                <p class="tier__price">
                  <span class="num">{tier.price}</span><span class="tier__unit">{tier.unit}</span>
                </p>
                <ul class="checks tier__inc">
                  {tier.includes.map((item) => <Check>{item}</Check>)}
                </ul>
                <a
                  class:list={['btn', tier.featured ? 'btn--primary' : 'btn--secondary', 'tier__cta']}
                  href={isBuilt('adAccounts') ? pathFor('adAccounts', lang) : site.bookingUrl}
                >
                  {c.common.requestAccount}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Per-platform account fees -->
    <section class="section section--band">
      <div class="container">
        <h2 class="secT">{p.platformsTitle}</h2>
        <p class="lead secL">{p.platformsLead}</p>
        <div class="tableWrap">
          <table class="tbl">
            <thead>
              <tr>
                <th scope="col">{p.colPlatform}</th>
                <th scope="col">{c.common.fee}</th>
                <th scope="col">{c.common.minBudget}</th>
                <th scope="col">{c.common.setup}</th>
              </tr>
            </thead>
            <tbody>
              {
                platforms.map((pf) => {
                  const meta = site.platforms[pf.key];
                  return (
                    <tr>
                      <th scope="row">
                        <span class="tbl__brand">
                          {pf.icons.map((icon) => <PlatformIcon name={icon} size={22} />)}
                          {isBuilt(pf.routeKey) ? (
                            <a href={pathFor(pf.routeKey, lang)}>{pf.label}</a>
                          ) : (
                            <span>{pf.label}</span>
                          )}
                        </span>
                      </th>
                      <td class="num">MAD {meta.fee}{c.common.perMonth}</td>
                      <td class="num">{meta.minBudget} MAD{c.common.perMonth}</td>
                      <td>{setupLabel[meta.setup as 'under24h' | 'h24to48']}</td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Build projects + UGC -->
    <section class="section">
      <div class="container two">
        <div>
          <h2 class="secT">{p.buildsTitle}</h2>
          <p class="lead secL">{p.buildsLead}</p>
          <dl class="rows">
            {
              builds.map((b) => (
                <div class="row">
                  <div>
                    <dt>{b.name}</dt>
                    <dd class="row__span num">{b.span} {c.home.buildWeeksUnit}</dd>
                  </div>
                  <p class="row__price num">{c.common.from} MAD {b.price}</p>
                </div>
              ))
            }
          </dl>
        </div>
        <div>
          <h2 class="secT">{p.ugcTitle}</h2>
          <p class="lead secL">{p.ugcLead}</p>
          <dl class="rows">
            <div class="row">
              <div>
                <dt>{p.ugcStandalone}</dt>
                <dd class="row__span">{p.ugcStandaloneNote}</dd>
              </div>
              <p class="row__price num">MAD {site.pricing.ugcPerVideo}</p>
            </div>
            <div class="row">
              <div>
                <dt>{p.ugcIncluded}</dt>
                <dd class="row__span">{p.ugcIncludedNote}</dd>
              </div>
              <p class="row__price">{p.ugcIncludedPrice}</p>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- What is never charged -->
    <section class="section section--band">
      <div class="container never">
        <h2 class="secT">{p.neverTitle}</h2>
        <ul class="checks">
          {p.neverItems.map((item) => <Check>{item}</Check>)}
        </ul>
      </div>
    </section>

    <Faq title={p.faqTitle} items={p.faq} />
    <CtaBand lang={lang} title={p.ctaTitle} lead={p.ctaLead} dark />
  </main>

  <Footer lang={lang} routeKey={routeKey} />
</Base>

<style>
  .hero {
    padding-block: var(--section-y);
    background: linear-gradient(180deg, var(--c-bg) 0%, var(--c-bg-2) 100%);
  }

  .hero__inner { max-width: 48rem; }
  .hero__lead { margin-block: var(--s-6); }
  .hero__caution { margin-block-start: var(--s-6); }

  .secT { margin-block-end: var(--s-4); }
  .secL { margin-block-end: var(--s-12); }

  .tiers { align-items: stretch; }

  .tier {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-8);
  }

  .tier--on {
    background: var(--c-green-tint);
    border-color: var(--c-green);
  }

  .tier__note {
    font-size: var(--t-small);
    color: var(--c-ink-3);
  }

  .tier__price {
    margin-block: var(--s-4);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .tier__unit {
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--c-ink-3);
  }

  .tier__inc { margin-block-end: var(--s-4); }
  .tier__cta { margin-block-start: auto; }

  /* A wide table scrolls inside a box rather than breaking the page. */
  .tableWrap {
    overflow-x: auto;
    border: 1px solid var(--c-line);
    border-radius: var(--r-panel);
    background: var(--c-bg);
  }

  .tbl {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
  }

  .tbl th,
  .tbl td {
    padding: var(--s-4) var(--s-6);
    text-align: start;
    font-size: var(--t-small);
    border-block-end: 1px solid var(--c-line);
  }

  .tbl thead th {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink-4);
    background: var(--c-bg-2);
  }

  :global(html[lang='ar']) .tbl thead th {
    letter-spacing: 0;
    text-transform: none;
  }

  .tbl tbody tr:last-child th,
  .tbl tbody tr:last-child td {
    border-block-end: 0;
  }

  .tbl__brand {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 700;
  }

  .two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(23.75rem, 100%), 1fr));
    gap: var(--s-12);
    align-items: start;
  }

  .rows {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: var(--s-4);
    border-block-end: 1px solid var(--c-line);
  }

  .row dt {
    font-size: 1rem;
    font-weight: 700;
  }

  .row__span {
    margin: 0;
    font-size: var(--t-xs);
    color: var(--c-ink-3);
  }

  .row__price {
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .never { max-width: 48rem; }
  .never .checks :global(li) { font-size: 0.96875rem; }
</style>

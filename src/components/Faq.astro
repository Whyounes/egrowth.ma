---
import type { FaqItem } from '../lib/schema';

export interface Props {
  title: string;
  items: FaqItem[];
  /** The first answer is open, so there is something to read without a click. */
  openFirst?: boolean;
}

const { title, items, openFirst = true } = Astro.props;
---

<section class="section section--band">
  <div class="container faq">
    <h2>{title}</h2>
    <div class="faq__list">
      {
        items.map((item, i) => (
          <details class="faq__item" open={openFirst && i === 0}>
            <summary class="faq__q">
              {item.q}
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path
                  d="M4 7.5l6 5.5 6-5.5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </summary>
            <p class="faq__a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 53.75rem;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-start: var(--s-12);
  }

  .faq__item {
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: var(--r-panel);
    padding: var(--s-6);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    font-size: 1.09375rem;
    font-weight: 700;
    letter-spacing: -0.012em;
    line-height: 1.4;
    color: var(--c-ink);
  }

  .faq__q svg {
    flex-shrink: 0;
    color: var(--c-ink-2);
    transition: transform var(--dur) var(--ease);
  }

  .faq__item[open] .faq__q svg {
    transform: rotate(180deg);
  }

  .faq__a {
    margin-block-start: var(--s-3);
    font-size: 0.96875rem;
    line-height: 1.65;
    color: var(--c-ink-2);
  }

  :global(html[lang='ar']) .faq__a {
    line-height: 1.85;
  }
</style>
